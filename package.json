{
  "name": "@kanzo-tech/metadata-form",
  "version": "0.1.0",
  "description": "Auto-generate editable React forms from SHACL shapes, powered by the rudof engine (WebAssembly). Edit an RDF graph and serialize to Turtle and JSON-LD.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanzo-Tech/metadata-form.git"
  },
  "homepage": "https://kanzo-tech.github.io/metadata-form/",
  "bugs": "https://github.com/Kanzo-Tech/metadata-form/issues",
  "keywords": [
    "rdf",
    "shacl",
    "shacl-ui",
    "rudof",
    "wasm",
    "form",
    "react",
    "dcat",
    "health-dcat-ap",
    "json-ld",
    "turtle",
    "metadata"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "tailwind.css",
    "README.md"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    },
    "./rudof": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./tailwind.css": "./tailwind.css"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build",
    "build:playground": "vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground/tsconfig.json",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@kanzo-tech/ai": "^0.27.0",
    "@kanzo-tech/llm": "^0.27.0",
    "@kanzo-tech/ui": "^0.27.0",
    "ai": "^7.0.0",
    "lucide-react": ">=1",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/react": {
      "optional": true
    },
    "@kanzo-tech/ai": {
      "optional": true
    },
    "@kanzo-tech/llm": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "dependencies": {
    "@kanzo-tech/rudof-wasm": "^0.3.10",
    "@rdfjs/types": "^1.1.2"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/react": "^4.0.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@eslint/js": "^9.39.4",
    "@kanzo-tech/ai": "^0.27.0",
    "@kanzo-tech/llm": "^0.27.0",
    "@kanzo-tech/theme": "^0.27.0",
    "@kanzo-tech/ui": "^0.27.0",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "ai": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "lucide-react": "^1.34.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
