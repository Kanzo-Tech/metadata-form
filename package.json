{
  "name": "metadata-form",
  "version": "0.1.0",
  "description": "Auto-generate editable React forms from SHACL/DASH shapes (extensible to ShEx). Output RDF metadata as Turtle and JSON-LD.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "rdf",
    "shacl",
    "dash",
    "shex",
    "form",
    "react",
    "dcat",
    "health-dcat-ap",
    "json-ld",
    "turtle",
    "metadata"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    },
    "./rudof": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:wasm": "bash ../rudof-fork/rudof_wasm/build.sh"
  },
  "peerDependencies": {
    "@radix-ui/react-icons": ">=1.3",
    "@radix-ui/themes": ">=3",
    "ai": ">=5",
    "react": ">=18",
    "react-dom": ">=18",
    "zod": ">=3.23"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@kanzo-tech/rudof-wasm": "^0.3.4",
    "downshift": "^9.3.6"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.86",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@eslint/js": "^9.39.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@rdfjs/types": "^1.1.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^4.3.4",
    "ai": "^6.0.209",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5",
    "zod": "^4.4.3"
  }
}
