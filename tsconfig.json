{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "metadata-form/ai": ["./src/ai/index.ts"],
      "metadata-form": ["./src/index.ts"],
      "@/*": ["./src/*"],
      "@examples/*": ["./playground/examples/*"],
      "@playground/*": ["./playground/src/*"]
    },
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true
  },
  "//": "The playground app is its own project (playground/tsconfig.json). This (lib + tests) keeps only the shared example fixtures the tests import via @examples, plus their ?raw ambient.",
  "include": [
    "src",
    "test",
    "playground/examples",
    "playground/raw.d.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
