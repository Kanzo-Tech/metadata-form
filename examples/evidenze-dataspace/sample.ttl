@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix evds: <https://dataspace.evidenze.example/ns#> .
@prefix evds-voc: <https://dataspace.evidenze.example/voc#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://dataspace.evidenze.example/dataset/registro-oncologico>
    a dcat:Dataset ;
    dct:title "Registro oncológico regional"@es ;
    dct:description "Conjunto de datos con casos oncológicos anonimizados para investigación clínica dentro del espacio de datos."@es ;
    dct:identifier "DS-ONC-001" ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dct:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    evds:accessJustification "Contiene datos de salud pseudonimizados; el acceso requiere acuerdo de tratamiento de datos." ;
    evds:participantDID "did:web:hospital.example.org" ;
    evds:dataspaceRole evds-voc:provider ;
    evds:environmentZone evds-voc:production ;
    dct:publisher <https://dataspace.evidenze.example/org/hospital> ;
    dcat:contactPoint <https://dataspace.evidenze.example/contact/dpo> ;
    dcat:distribution <https://dataspace.evidenze.example/dist/onc-api> .

<https://dataspace.evidenze.example/org/hospital>
    a foaf:Agent ;
    foaf:name "Hospital Regional" ;
    foaf:homepage <https://hospital.example.org> .

<https://dataspace.evidenze.example/contact/dpo>
    a vcard:Kind ;
    vcard:fn "Delegado de Protección de Datos" ;
    vcard:hasEmail <mailto:dpo@hospital.example.org> .

<https://dataspace.evidenze.example/dist/onc-api>
    a dcat:Distribution ;
    dcat:accessURL <https://api.hospital.example.org/onc> ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/API> .
