# npm walks the peer set of OPTIONAL peers too, and @kanzo-tech/ui declares
# @uwdata/mosaic-core among its optional peers. That package is published with
# `"peerDependencies": { "@uwdata/mosaic-duckdb": "workspace:^" }` — an upstream
# bug npm cannot parse, so it dies with EUNSUPPORTEDPROTOCOL before installing
# anything, even though we never install Mosaic.
#
# kanzo-ui's own scripts/smoke-install.mjs carries the same flag for the same
# reason. Remove this when the upstream range is fixed.
legacy-peer-deps=true
