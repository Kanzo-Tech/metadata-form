@prefix dash: <http://datashapes.org/dash#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dpv:  <https://w3id.org/dpv#> .
@prefix hri:  <http://data.health-ri.nl/core/p2/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# Overlay 01 — SHACL 1.0, node-shape partition selected by sh:targetSubjectsOf.
#
# The DASH-era idiom: the condition cannot be attached to hri:DatasetShape, so it
# becomes a SECOND node shape over the same population, selected by a target that
# happens to coincide with the condition. The discriminator is re-stated inside
# the branch as a property shape the form must not show — hence dash:hidden.

hri:PersonalDataDatasetShape
  a sh:NodeShape ;
  rdfs:label "Dataset carrying personal data"@en ;
  sh:targetSubjectsOf dpv:hasPersonalData ;
  sh:property hri:PersonalDataDatasetShape-stamp ,
              hri:PersonalDataDatasetShape-legal-basis ,
              hri:PersonalDataDatasetShape-purpose .

# The hidden stamp: not a field the author fills in, only the discriminator
# written down a second time so the branch is self-describing.
hri:PersonalDataDatasetShape-stamp
  sh:path dpv:hasPersonalData ;
  sh:minCount 1 ;
  dash:hidden true .

hri:PersonalDataDatasetShape-legal-basis
  sh:path dpv:hasLegalBasis ;
  sh:name "legal basis"@en ;
  sh:minCount 1 ;
  sh:nodeKind sh:IRI ;
  dash:viewer dash:URIViewer ;
  dash:editor dash:URIEditor .

hri:PersonalDataDatasetShape-purpose
  sh:path dpv:hasPurpose ;
  sh:name "purpose"@en ;
  sh:minCount 1 ;
  sh:nodeKind sh:IRI ;
  dash:viewer dash:LabelViewer ;
  dash:editor dash:URIEditor .
