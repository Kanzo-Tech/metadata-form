@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dpv:  <https://w3id.org/dpv#> .
@prefix hri:  <http://data.health-ri.nl/core/p2/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .

# Overlay 05 — SHACL 1.2 sh:targetWhere.
#
# The same requirement as overlay-03 (implication) and overlay-04 (sh:if), stated
# as a target: the constrainer applies to every node that conforms to the selector.
# The selector mirrors overlay-03's condition exactly (hasPersonalData minCount 1),
# restricted to the class hri:DatasetShape targets (dcat:Dataset).

hri:PersonalDataSelector
  a sh:NodeShape ;
  rdfs:label "a dataset that declares personal data"@en ;
  sh:class dcat:Dataset ;
  sh:property [ sh:path dpv:hasPersonalData ; sh:minCount 1 ] .

hri:PersonalDataRequirements
  a sh:NodeShape ;
  sh:targetWhere hri:PersonalDataSelector ;
  sh:property hri:DatasetShape-legal-basis-required ,
              hri:DatasetShape-purpose-required .

hri:DatasetShape-legal-basis-required
  sh:path dpv:hasLegalBasis ;
  sh:name "legal basis"@en ;
  sh:minCount 1 ;
  sh:nodeKind sh:IRI ;
  shui:editor shui:IRIEditor ;
  sh:message "A dataset that declares personal data must state its legal basis."@en .

hri:DatasetShape-purpose-required
  sh:path dpv:hasPurpose ;
  sh:name "purpose"@en ;
  sh:minCount 1 ;
  sh:nodeKind sh:IRI ;
  shui:editor shui:IRIEditor ;
  sh:message "A dataset that declares personal data must state the purpose of processing."@en .
