@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/> .

ex:DatasetShape a sh:NodeShape ;
    sh:targetClass ex:Dataset ;

    # C1 — three lang-tagged messages on one constraint.
    # SHACL 1.0 §2.1.5 / 1.2 §3.1.5: "all validation results produced as a
    # result of the shape will have exactly these messages as their value
    # of sh:resultMessage, i.e. the values will be copied from the shapes
    # graph into the results graph."
    sh:property [
        sh:path ex:identifier ;
        sh:minCount 1 ;
        sh:message "A dataset must have an identifier."@en ;
        sh:message "Un conjunto de datos debe tener un identificador."@es ;
        sh:message "Un conjunt de dades ha de tenir un identificador."@ca ;
    ] ;

    # C2 — control: a single message with no language tag (xsd:string).
    sh:property [
        sh:path ex:issued ;
        sh:datatype xsd:date ;
        sh:message "Issue date must be an xsd:date." ;
    ] .
