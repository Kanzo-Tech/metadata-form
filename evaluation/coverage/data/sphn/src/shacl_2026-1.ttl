constraints:sphnAllergen_Info_NotValid a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The versioned code reachable by path sphn:hasCode/rdf:type is not valid anymore due to code meaning change" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                     PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                     SELECT ?this (rdf:type as ?path) (?type as ?value)
                     WHERE {
                         ?this sphn:hasCode/rdf:type ?type .
                         ?type sphn:hasMeaningValidityInCurrent ?validity .
                         FILTER(?validity = false)
                     }""" ] ;
    sh:targetClass sphn:Allergen .

constraints:sphnAllergen_Info_StillValid a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The versioned code reachable by path sphn:hasCode/rdf:type is old but still valid" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                     PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                     SELECT ?this (rdf:type as ?path) (?type as ?value)
                     WHERE {
                         ?this sphn:hasCode/rdf:type ?type .
                         ?type sphn:hasMeaningValidityInCurrent ?validity .
                         FILTER NOT EXISTS { ?type sphn:isCurrent true . }
                         FILTER(?validity = true)
                     }""" ] ;
    sh:targetClass sphn:Allergen .

constraints:sphnAllergen_Warning_MeaningChange a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The unversioned code reachable at path sphn:hasCode has changed its meaning during the time. Please consider using a versioned code." ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                            SELECT ?this (rdf:type as ?path) (STR(?codeChange) as ?value)
                            WHERE {
                                ?this sphn:hasCode/rdf:type ?type .
                                ?type sphn:hasMeaningChangeInHistorization ?codeChange .
                                }""" ] ;
    sh:targetClass sphn:Allergen .

