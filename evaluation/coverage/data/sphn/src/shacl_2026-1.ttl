constraints:sphnImagingFrame a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sphn:ImagingFrame_type ;
            sh:minCount 0 ;
            sh:path sphn:hasType ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasStartDateTime ],
        [ sh:class sphn:ImageDimensions ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasImageDimensions ],
        [ sh:class sphn:BodySite ;
            sh:minCount 0 ;
            sh:path sphn:hasBodySite ],
        [ sh:class sphn:ImagingFrame_contentQualification ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasContentQualification ],
        [ sh:class sphn:DataCompressionAlgorithm ;
            sh:minCount 0 ;
            sh:path sphn:hasAlgorithm ],
        [ sh:class sphn:AnatomicalProjection ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasAnatomicalProjection ],
        [ sh:class sphn:ImagingMetric ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasImagingMetric ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasEndDateTime ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Invalid time frame between sphn:hasStartDateTime and sphn:hasEndDateTime" ;
            sh:select """SELECT ?this (<https://biomedit.ch/rdf/sphn-schema/sphn#hasStartDateTime> as ?path) (?hasStartDateTime as ?value)
                    WHERE {
                        ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasStartDateTime> ?hasStartDateTime .
                        ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasEndDateTime> ?hasEndDateTime .
                        FILTER (?hasStartDateTime > ?hasEndDateTime)
                    }""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            SELECT ?this
                WHERE {
                ?this rdf:type sphn:ImagingFrame .
                MINUS {
                    ?this rdf:type sphn:ImagingFrame .
                    ?this rdf:type ?other_type .
                    FILTER (?other_type != sphn:ImagingFrame )
                    ?this rdfs:subClassOf+  sphn:ImagingFrame .
                    }
                }""" ] .

constraints:sphnImagingFrame_Warning_NamingConvention a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Instantiated unique resource not matching naming convention '^https://biomedit.ch/rdf/sphn-resource/.*-ImagingFrame-.*$'" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                         PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                         PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                         SELECT ?this (?class as ?path) (?this as ?value)
                         WHERE {
                             ?this rdf:type ?class .
                             FILTER(!REGEX(STR(?this), "^https://biomedit.ch/rdf/sphn-resource/.*-ImagingFrame-.*$"))
                             }""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            SELECT ?this
                WHERE {
                ?this rdf:type sphn:ImagingFrame .
                MINUS {
                    ?this rdf:type sphn:ImagingFrame .
                    ?this rdf:type ?other_type .
                    FILTER (?other_type != sphn:ImagingFrame )
                    ?this rdfs:subClassOf+  sphn:ImagingFrame .
                    }
                }""" ] .

constraints:sphnImagingFrame_contentQualification a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdfs:label rdf:type ) ;
    sh:property [ sh:in ( sphn-individual:Research sphn-individual:Product sphn-individual:Service ) ;
            sh:path [ sh:inversePath rdf:type ] ] ;
    sh:targetClass sphn:ImagingFrame_contentQualification .

