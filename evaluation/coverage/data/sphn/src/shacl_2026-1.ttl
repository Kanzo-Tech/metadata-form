                MINUS {
                    ?this rdf:type sphn:SampleProcessing .
                    ?this rdf:type ?other_type .
                    FILTER (?other_type != sphn:SampleProcessing )
                    ?this rdfs:subClassOf+  sphn:SampleProcessing .
                    }
                }""" ] .

constraints:sphnSampleProcessing_Info_StillValid a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The versioned code reachable by path sphn:hasCode/rdf:type is old but still valid" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                     PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                     SELECT ?this (rdf:type as ?path) (?type as ?value)
                     WHERE {
                         ?this sphn:hasCode/rdf:type ?type .
                         ?type sphn:hasMeaningValidityInCurrent ?validity .
                         FILTER NOT EXISTS { ?type sphn:isCurrent true . }
                         FILTER(?validity = true)
                     }""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            SELECT ?this
                WHERE {
                ?this rdf:type sphn:SampleProcessing .
                MINUS {
                    ?this rdf:type sphn:SampleProcessing .
                    ?this rdf:type ?other_type .
                    FILTER (?other_type != sphn:SampleProcessing )
                    ?this rdfs:subClassOf+  sphn:SampleProcessing .
                    }
                }""" ] .

constraints:sphnSampleProcessing_Warning_DeprecatedCode a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Deprecated unversioned code reachable at path sphn:hasCode" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            PREFIX sphn-loinc: <https://biomedit.ch/rdf/sphn-resource/loinc/>
            PREFIX sphn-hgnc: <https://biomedit.ch/rdf/sphn-resource/hgnc/>
            SELECT ?this (sphn:hasCode as ?path) (?typeCode as ?value)
            WHERE {
            {
                ?this sphn:hasCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-loinc:LOINC .
                ?typeCode rdfs:label ?label .
                FILTER(STRSTARTS(lcase(STR(?label)), "deprecated"))
            }
            UNION
            {
                ?this sphn:hasCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                {
                    SELECT ?typeCode
                    WHERE {
                        ?typeCode rdf:type ?codeType .
                        FILTER(STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/GENO_") || STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/SO_"))
                    }
                }
                ?typeCode owl:deprecated ?isDeprecated .
                FILTER(?isDeprecated)
            }
            UNION
            {
                ?this sphn:hasCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-hgnc:HGNC .
                ?typeCode rdfs:comment ?comment .
                FILTER(lcase(STR(?comment))="entry withdrawn" || lcase(STR(?comment))="symbol withdrawn")
            }
            }""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            SELECT ?this
                WHERE {
                ?this rdf:type sphn:SampleProcessing .
                MINUS {
                    ?this rdf:type sphn:SampleProcessing .
                    ?this rdf:type ?other_type .
                    FILTER (?other_type != sphn:SampleProcessing )
                    ?this rdfs:subClassOf+  sphn:SampleProcessing .
                    }
                }""" ] .

constraints:sphnSampleProcessing_Warning_MeaningChange a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The unversioned code reachable at path sphn:hasCode has changed its meaning during the time. Please consider using a versioned code." ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                            SELECT ?this (rdf:type as ?path) (STR(?codeChange) as ?value)
                            WHERE {
                                ?this sphn:hasCode/rdf:type ?type .
                                ?type sphn:hasMeaningChangeInHistorization ?codeChange .
                                }""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            SELECT ?this
                WHERE {
                ?this rdf:type sphn:SampleProcessing .
                MINUS {
                    ?this rdf:type sphn:SampleProcessing .
                    ?this rdf:type ?other_type .
                    FILTER (?other_type != sphn:SampleProcessing )
                    ?this rdfs:subClassOf+  sphn:SampleProcessing .
                    }
                }""" ] .

