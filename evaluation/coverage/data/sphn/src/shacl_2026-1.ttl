            sh:message "No descendents (all subclasses) of the specified codes are allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
