                             FILTER(?class IN (<https://biomedit.ch/rdf/sphn-schema/sphn#AccessDevice>, <https://biomedit.ch/rdf/sphn-schema/sphn#LabAnalyzer>, <https://biomedit.ch/rdf/sphn-schema/sphn#ImagingDevice>))
                         }""" ],
