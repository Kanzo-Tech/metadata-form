    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sphn:BodySite ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasBodySite ],
