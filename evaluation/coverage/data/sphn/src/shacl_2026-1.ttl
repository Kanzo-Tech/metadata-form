        [ sh:class sphn:BodySite ;
            sh:minCount 0 ;
            sh:path sphn:hasBodySite ],
        [ sh:class sphn:ContrastAgentAdministrationEvent ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasContrastAgentAdministrationEvent ],
        [ sh:class sphn:ContrastAgentPhase ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasContrastAgentPhase ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasStartDateTime ],
        [ sh:class sphn:ImageDimensions ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasImageDimensions ],
        [ sh:class sphn:ImagingFrame_contentQualification ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasContentQualification ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasEndDateTime ],
        [ sh:minCount 0 ;
            sh:or ( [ sh:class sphn:Synchronization ] [ sh:class sphn:RespiratorySynchronization ] [ sh:class sphn:CardiacSynchronization ] ) ;
            sh:path sphn:hasSynchronization ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Invalid time frame between sphn:hasStartDateTime and sphn:hasEndDateTime" ;
            sh:select """SELECT ?this (<https://biomedit.ch/rdf/sphn-schema/sphn#hasStartDateTime> as ?path) (?hasStartDateTime as ?value)
                    WHERE {
                        ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasStartDateTime> ?hasStartDateTime .
                        ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasEndDateTime> ?hasEndDateTime .
                        FILTER (?hasStartDateTime > ?hasEndDateTime)
                    }""" ] ;
    sh:targetClass sphn:XRayImagingFrame .

constraints:sphnXRayImagingFrame_Warning_NamingConvention a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
