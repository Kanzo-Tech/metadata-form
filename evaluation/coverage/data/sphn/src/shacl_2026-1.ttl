constraints:sphnVariantDescriptor_Info_NotValid a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The versioned code reachable by path sphn:hasCode/rdf:type is not valid anymore due to code meaning change" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                     PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                     SELECT ?this (rdf:type as ?path) (?type as ?value)
                     WHERE {
                         ?this sphn:hasCode/rdf:type ?type .
                         ?type sphn:hasMeaningValidityInCurrent ?validity .
                         FILTER(?validity = false)
                     }""" ] ;
    sh:targetClass sphn:VariantDescriptor .

constraints:sphnVariantDescriptor_Info_StillValid a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The versioned code reachable by path sphn:hasCode/rdf:type is old but still valid" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                     PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                     SELECT ?this (rdf:type as ?path) (?type as ?value)
                     WHERE {
                         ?this sphn:hasCode/rdf:type ?type .
                         ?type sphn:hasMeaningValidityInCurrent ?validity .
                         FILTER NOT EXISTS { ?type sphn:isCurrent true . }
                         FILTER(?validity = true)
                     }""" ] ;
    sh:targetClass sphn:VariantDescriptor .

constraints:sphnVariantDescriptor_Warning_DeprecatedCode a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Deprecated unversioned code reachable at path sphn:hasZygosityCode" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            PREFIX sphn-loinc: <https://biomedit.ch/rdf/sphn-resource/loinc/>
            PREFIX sphn-hgnc: <https://biomedit.ch/rdf/sphn-resource/hgnc/>
            SELECT ?this (sphn:hasZygosityCode as ?path) (?typeCode as ?value)
            WHERE {
            {
                ?this sphn:hasZygosityCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-loinc:LOINC .
                ?typeCode rdfs:label ?label .
                FILTER(STRSTARTS(lcase(STR(?label)), "deprecated"))
            }
            UNION
            {
                ?this sphn:hasZygosityCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                {
                    SELECT ?typeCode
                    WHERE {
                        ?typeCode rdf:type ?codeType .
                        FILTER(STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/GENO_") || STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/SO_"))
                    }
                }
                ?typeCode owl:deprecated ?isDeprecated .
                FILTER(?isDeprecated)
            }
            UNION
            {
                ?this sphn:hasZygosityCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-hgnc:HGNC .
                ?typeCode rdfs:comment ?comment .
                FILTER(lcase(STR(?comment))="entry withdrawn" || lcase(STR(?comment))="symbol withdrawn")
            }
            }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "Deprecated unversioned code reachable at path sphn:hasCode" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            PREFIX sphn-loinc: <https://biomedit.ch/rdf/sphn-resource/loinc/>
            PREFIX sphn-hgnc: <https://biomedit.ch/rdf/sphn-resource/hgnc/>
            SELECT ?this (sphn:hasCode as ?path) (?typeCode as ?value)
            WHERE {
            {
                ?this sphn:hasCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-loinc:LOINC .
                ?typeCode rdfs:label ?label .
                FILTER(STRSTARTS(lcase(STR(?label)), "deprecated"))
            }
            UNION
            {
                ?this sphn:hasCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                {
                    SELECT ?typeCode
                    WHERE {
                        ?typeCode rdf:type ?codeType .
                        FILTER(STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/GENO_") || STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/SO_"))
                    }
                }
                ?typeCode owl:deprecated ?isDeprecated .
                FILTER(?isDeprecated)
            }
            UNION
            {
                ?this sphn:hasCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-hgnc:HGNC .
                ?typeCode rdfs:comment ?comment .
                FILTER(lcase(STR(?comment))="entry withdrawn" || lcase(STR(?comment))="symbol withdrawn")
            }
            }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "Deprecated unversioned code reachable at path sphn:hasTypeCode" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            PREFIX sphn-loinc: <https://biomedit.ch/rdf/sphn-resource/loinc/>
            PREFIX sphn-hgnc: <https://biomedit.ch/rdf/sphn-resource/hgnc/>
            SELECT ?this (sphn:hasTypeCode as ?path) (?typeCode as ?value)
            WHERE {
            {
                ?this sphn:hasTypeCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-loinc:LOINC .
                ?typeCode rdfs:label ?label .
                FILTER(STRSTARTS(lcase(STR(?label)), "deprecated"))
            }
            UNION
            {
                ?this sphn:hasTypeCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                {
                    SELECT ?typeCode
                    WHERE {
                        ?typeCode rdf:type ?codeType .
                        FILTER(STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/GENO_") || STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/SO_"))
                    }
                }
                ?typeCode owl:deprecated ?isDeprecated .
                FILTER(?isDeprecated)
            }
            UNION
            {
                ?this sphn:hasTypeCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-hgnc:HGNC .
                ?typeCode rdfs:comment ?comment .
                FILTER(lcase(STR(?comment))="entry withdrawn" || lcase(STR(?comment))="symbol withdrawn")
            }
            }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "Deprecated unversioned code reachable at path sphn:hasAlleleOriginCode" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            PREFIX sphn-loinc: <https://biomedit.ch/rdf/sphn-resource/loinc/>
            PREFIX sphn-hgnc: <https://biomedit.ch/rdf/sphn-resource/hgnc/>
            SELECT ?this (sphn:hasAlleleOriginCode as ?path) (?typeCode as ?value)
            WHERE {
            {
                ?this sphn:hasAlleleOriginCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-loinc:LOINC .
                ?typeCode rdfs:label ?label .
                FILTER(STRSTARTS(lcase(STR(?label)), "deprecated"))
            }
            UNION
            {
                ?this sphn:hasAlleleOriginCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                {
                    SELECT ?typeCode
                    WHERE {
                        ?typeCode rdf:type ?codeType .
                        FILTER(STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/GENO_") || STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/SO_"))
                    }
                }
                ?typeCode owl:deprecated ?isDeprecated .
                FILTER(?isDeprecated)
            }
            UNION
            {
                ?this sphn:hasAlleleOriginCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-hgnc:HGNC .
                ?typeCode rdfs:comment ?comment .
                FILTER(lcase(STR(?comment))="entry withdrawn" || lcase(STR(?comment))="symbol withdrawn")
            }
            }""" ] ;
    sh:targetClass sphn:VariantDescriptor .

constraints:sphnVariantDescriptor_Warning_MeaningChange a sh:NodeShape ;
