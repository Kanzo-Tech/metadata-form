        [ sh:class sphn:AnatomicalProjection ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasAnatomicalProjection ],
        [ sh:class sphn:ImagingMetric ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
