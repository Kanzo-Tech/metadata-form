            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasMethodCode ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class sphn:MedicalDevice ] [ sh:class sphn:Implant ] ) ;
