constraints:sphnPositronEmissionTomographyImagingFrame a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( sphn:hasSubjectPhysiologicState rdf:type ) ;
    sh:property [ sh:class sphn:AnatomicalProjection ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasAnatomicalProjection ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class dcm:109093 ] [ sh:class sphn:Terminology ] [ sh:class sphn:Code ] [ sh:class dcm:109092 ] [ sh:class dcm:109094 ] ) ;
            sh:path sphn:hasCardiacProceduralStateCode ],
        [ sh:class sphn:RadiopharmaceuticalAdministrationEvent ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasRadiopharmaceuticalAdministrationEvent ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class snomed:432655005 ] [ sh:class snomed:128975004 ] ) ;
            sh:path ( sphn:hasSubjectPhysiologicState sphn:hasCode ) ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasEndDateTime ],
        [ sh:class sphn:BodySite ;
            sh:minCount 0 ;
            sh:path sphn:hasBodySite ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasStartDateTime ],
        [ sh:class sphn:DataCompressionAlgorithm ;
            sh:minCount 0 ;
            sh:path sphn:hasAlgorithm ],
        [ sh:class sphn:ImagingFrame_type ;
            sh:minCount 0 ;
            sh:path sphn:hasType ],
        [ sh:class sphn:ImagingMetric ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasImagingMetric ],
        [ sh:class sphn:ImageDimensions ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasImageDimensions ],
        [ sh:minCount 0 ;
            sh:or ( [ sh:class sphn:Synchronization ] [ sh:class sphn:RespiratorySynchronization ] [ sh:class sphn:CardiacSynchronization ] ) ;
            sh:path sphn:hasSynchronization ],
        [ sh:class sphn:ImagingFrame_contentQualification ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasContentQualification ],
        [ sh:class sphn:PhysiologicState ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasSubjectPhysiologicState ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "No descendents (all subclasses) of the specified codes are allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                                                PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                                                SELECT ?this ("sphn:hasSubjectPhysiologicState/sphn:hasCode" as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasSubjectPhysiologicState/sphn:hasCode/rdf:type ?class .
                                                    FILTER( ?values IN ( <http://snomed.info/id/432655005>, <http://snomed.info/id/128975004> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "No descendents (all subclasses) of the specified codes are allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                                                PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                                                SELECT ?this (sphn:hasSubjectPhysiologicState as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasSubjectPhysiologicState/rdf:type ?class .
                                                    FILTER( ?values IN ( <https://biomedit.ch/rdf/sphn-schema/sphn#PhysiologicState> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "No descendents (all subclasses) of the specified codes are allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                                                PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                                                SELECT ?this (sphn:hasCardiacProceduralStateCode as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasCardiacProceduralStateCode/rdf:type ?class .
                                                    FILTER( ?values IN ( <http://dicom.nema.org/resources/ontology/DCM/109093>, <https://biomedit.ch/rdf/sphn-schema/sphn#Terminology>, <https://biomedit.ch/rdf/sphn-schema/sphn#Code>, <http://dicom.nema.org/resources/ontology/DCM/109092>, <http://dicom.nema.org/resources/ontology/DCM/109094> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "Invalid time frame between sphn:hasStartDateTime and sphn:hasEndDateTime" ;
            sh:select """SELECT ?this (<https://biomedit.ch/rdf/sphn-schema/sphn#hasStartDateTime> as ?path) (?hasStartDateTime as ?value)
                    WHERE {
                        ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasStartDateTime> ?hasStartDateTime .
                        ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasEndDateTime> ?hasEndDateTime .
                        FILTER (?hasStartDateTime > ?hasEndDateTime)
                    }""" ] ;
    sh:targetClass sphn:PositronEmissionTomographyImagingFrame .

constraints:sphnPositronEmissionTomographyImagingFrame_Info_NotValid a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The versioned code reachable by path sphn:hasCardiacProceduralStateCode/rdf:type is not valid anymore due to code meaning change" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                     PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                     SELECT ?this (rdf:type as ?path) (?type as ?value)
                     WHERE {
                         ?this sphn:hasCardiacProceduralStateCode/rdf:type ?type .
                         ?type sphn:hasMeaningValidityInCurrent ?validity .
                         FILTER(?validity = false)
                     }""" ] ;
    sh:targetClass sphn:PositronEmissionTomographyImagingFrame .

constraints:sphnPositronEmissionTomographyImagingFrame_Info_StillValid a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The versioned code reachable by path sphn:hasCardiacProceduralStateCode/rdf:type is old but still valid" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                     PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                     SELECT ?this (rdf:type as ?path) (?type as ?value)
                     WHERE {
                         ?this sphn:hasCardiacProceduralStateCode/rdf:type ?type .
                         ?type sphn:hasMeaningValidityInCurrent ?validity .
                         FILTER NOT EXISTS { ?type sphn:isCurrent true . }
                         FILTER(?validity = true)
                     }""" ] ;
    sh:targetClass sphn:PositronEmissionTomographyImagingFrame .

constraints:sphnPositronEmissionTomographyImagingFrame_Warning_DeprecatedCode a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Deprecated unversioned code reachable at path sphn:hasCardiacProceduralStateCode" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            PREFIX sphn-loinc: <https://biomedit.ch/rdf/sphn-resource/loinc/>
            PREFIX sphn-hgnc: <https://biomedit.ch/rdf/sphn-resource/hgnc/>
            SELECT ?this (sphn:hasCardiacProceduralStateCode as ?path) (?typeCode as ?value)
            WHERE {
            {
                ?this sphn:hasCardiacProceduralStateCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-loinc:LOINC .
                ?typeCode rdfs:label ?label .
                FILTER(STRSTARTS(lcase(STR(?label)), "deprecated"))
            }
            UNION
            {
                ?this sphn:hasCardiacProceduralStateCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                {
                    SELECT ?typeCode
                    WHERE {
                        ?typeCode rdf:type ?codeType .
                        FILTER(STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/GENO_") || STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/SO_"))
                    }
                }
                ?typeCode owl:deprecated ?isDeprecated .
                FILTER(?isDeprecated)
            }
            UNION
            {
                ?this sphn:hasCardiacProceduralStateCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-hgnc:HGNC .
                ?typeCode rdfs:comment ?comment .
                FILTER(lcase(STR(?comment))="entry withdrawn" || lcase(STR(?comment))="symbol withdrawn")
            }
            }""" ] ;
    sh:targetClass sphn:PositronEmissionTomographyImagingFrame .

constraints:sphnPositronEmissionTomographyImagingFrame_Warning_MeaningChange a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The unversioned code reachable at path sphn:hasCardiacProceduralStateCode has changed its meaning during the time. Please consider using a versioned code." ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                            SELECT ?this (rdf:type as ?path) (STR(?codeChange) as ?value)
                            WHERE {
                                ?this sphn:hasCardiacProceduralStateCode/rdf:type ?type .
                                ?type sphn:hasMeaningChangeInHistorization ?codeChange .
                                }""" ] ;
    sh:targetClass sphn:PositronEmissionTomographyImagingFrame .

constraints:sphnPositronEmissionTomographyImagingFrame_Warning_NamingConvention a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Instantiated shared resource not matching naming convention '^https://biomedit.ch/rdf/sphn-resource/.*-Code-.*$'" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                    PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                    SELECT ?this ("sphn:hasSubjectPhysiologicState/sphn:hasCode" as ?path) (?code as ?value)
                    WHERE {
                        ?this sphn:hasSubjectPhysiologicState/sphn:hasCode ?code .
                        FILTER(!REGEX(STR(?code), "^https://biomedit.ch/rdf/sphn-resource/.*-Code-.*$"))
                        }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "Instantiated unique resource not matching naming convention '^https://biomedit.ch/rdf/sphn-resource/.*-PositronEmissionTomographyImagingFrame-.*$'" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                         PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
