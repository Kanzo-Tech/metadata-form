                MINUS {
                    ?this rdf:type sphn:LabTest .
                    ?this rdf:type ?other_type .
                    FILTER (?other_type != sphn:LabTest )
                    ?this rdfs:subClassOf+  sphn:LabTest .
                    }
                }""" ] .

constraints:sphnLabTest_Warning_NamingConvention a sh:NodeShape ;
    sh:severity sh:Warning ;
