    sh:ignoredProperties ( rdfs:label rdf:type ) ;
    sh:property [ sh:in ( sphn-individual:SpatiallyRelatedFrames sphn-individual:Thumbnail sphn-individual:Maximum sphn-individual:PhaseSubtract sphn-individual:StereoMinus sphn-individual:MetaboliteMap sphn-individual:MatFractional sphn-individual:ReconTomo sphn-individual:ElectronDensity sphn-individual:Fluence sphn-individual:Fluoroscopy sphn-individual:FetalHeart sphn-individual:CardiacGated sphn-individual:StereoL sphn-individual:CWDoppler sphn-individual:Localizer sphn-individual:Intraoperative sphn-individual:Parallel sphn-individual:Vascular sphn-individual:PostfireMinus sphn-individual:ModulusSubtract sphn-individual:Filtered sphn-individual:FluidAttenuated sphn-individual:Primary sphn-individual:Endorectal sphn-individual:Chest sphn-individual:ColorPowerMode sphn-individual:TTE sphn-individual:Perfusion sphn-individual:Montage sphn-individual:TEE sphn-individual:BiplaneA sphn-individual:GatedTomo sphn-individual:VMI sphn-individual:Musculoskeletal sphn-individual:Blank sphn-individual:Dynamic sphn-individual:Quantity sphn-individual:DensityMap sphn-individual:Multiecho sphn-individual:CardiacCascore sphn-individual:Overview sphn-individual:Reference sphn-individual:Intravascular sphn-individual:CardiacCTA sphn-individual:Label sphn-individual:ReconGatedTomo sphn-individual:Pediatric sphn-individual:Other sphn-individual:T2Map sphn-individual:Abdominal sphn-individual:Intracardiac sphn-individual:Scrotal sphn-individual:Division sphn-individual:USBiopsy sphn-individual:Radiograph sphn-individual:SmallParts sphn-individual:NeonatalHead sphn-individual:NonParallel sphn-individual:Ophthalmic sphn-individual:None sphn-individual:TomoProj sphn-individual:Stress sphn-individual:PostfirePlus sphn-individual:RespGated sphn-individual:MatSpecific sphn-individual:Longitudinal sphn-individual:TissueCharacterization sphn-individual:MatValueBased sphn-individual:TOF sphn-individual:Pelvic sphn-individual:Static sphn-individual:Derived sphn-individual:HighEnergy sphn-ind