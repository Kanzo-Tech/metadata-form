urces/ontology/DCM/113293>, <http://dicom.nema.org/resources/ontology/DCM/126224>, <http://dicom.nema.org/resources/ontology/DCM/110808>, <http://dicom.nema.org/resources/ontology/DCM/110847>, <http://dicom.nema.org/resources/ontology/DCM/113296>, <http://snomed.info/id/115391007>, <http://dicom.nema.org/resources/ontology/DCM/110842>, <http://dicom.nema.org/resources/ontology/DCM/110824>, <http://dicom.nema.org/resources/ontology/DCM/110854>, <http://snomed.info/id/70106000>, <http://snomed.info/id/14804005>, <http://dicom.nema.org/resources/ontology/DCM/110816>, <http://dicom.nema.org/resources/ontology/DCM/113067>, <http://dicom.nema.org/resources/ontology/DCM/113069>, <http://dicom.nema.org/resources/ontology/DCM/110800>, <http://dicom.nema.org/resources/ontology/DCM/126222>, <http://dicom.nema.org/resources/ontology/DCM/110823>, <http://dicom.nema.org/resources/ontology/DCM/113064>, <http://dicom.nema.org/resources/ontology/DCM/110855>, <http://dicom.nema.org/resources/ontology/DCM/110821>, <http://snomed.info/id/11713004>, <http://dicom.nema.org/resources/ontology/DCM/110818>, <http://dicom.nema.org/resources/ontology/DCM/113066>, <http://dicom.nema.org/resources/ontology/DCM/113060>, <http://snomed.info/id/65123005>, <http://dicom.nema.org/resources/ontology/DCM/110852>, <http://dicom.nema.org/resources/ontology/DCM/110811>, <http://dicom.nema.org/resources/ontology/DCM/113043>, <http://dicom.nema.org/resources/ontology/DCM/126403>, <http://dicom.nema.org/resources/ontology/DCM/113041>, <http://dicom.nema.org/resources/ontology/DCM/113081>, <http://dicom.nema.org/resources/ontology/DCM/126323>, <http://dicom.nema.org/resources/ontology/DCM/110845>, <http://dicom.nema.org/resources/ontology/DCM/113082>, <http://dicom.nema.org/resources/ontology/DCM/129102>, <http://dicom.nema.org/resources/ontology/DCM/110832>, <http://dicom.nema.org/resources/ontology/DCM/113084>, <http://dicom.nema.org/resources/ontology/DCM/126398>, <http://dicom.nema.org/resources/ontology/DCM/110813>, <http://dicom.nema.org/resources/ontology/DCM/130403>, <http://dicom.nema.org/resources/ontology/DCM/126394>, <http://dicom.nema.org/resources/ontology/DCM/113297>, <http://dicom.nema.org/resources/ontology/DCM/113095>, <http://dicom.nema.org/resources/ontology/DCM/126330>, <http://dicom.nema.org/resources/ontology/DCM/126321>, <http://dicom.nema.org/resources/ontology/DCM/110830>, <http://dicom.nema.org/resources/ontology/DCM/110815>, <http://dicom.nema.org/resources/ontology/DCM/110837>, <http://dicom.nema.org/resources/ontology/DCM/113098> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ] ;
    sh:targetClass sphn:ImagingMetric .

constraints:sphnImagingMetric_Info_NotValid a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The versioned code reachable by path sphn:hasTypeCode/rdf:type is not valid anymore due to code meaning change" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                     PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                     SELECT ?this (rdf:type as ?path) (?type as ?value)
                     WHERE {
                         ?this sphn:hasTypeCode/rdf:type ?type .
                         ?type sphn:hasMeaningValidityInCurrent ?validity .
                         FILTER(?validity = false)
                     }""" ] ;
    sh:targetClass sphn:ImagingMetric .

constraints:sphnImagingMetric_Info_StillValid a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The versioned code reachable by path sphn:hasTypeCode/rdf:type is old but still valid" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                     PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                     SELECT ?this (rdf:type as ?path) (?type as ?value)
                     WHERE {
                         ?this sphn:hasTypeCode/rdf:type ?type .
                         ?type sphn:hasMeaningValidityInCurrent ?validity .
                         FILTER NOT EXISTS { ?type sphn:isCurrent true . }
                         FILTER(?validity = true)
                     }""" ] ;
    sh:targetClass sphn:ImagingMetric .

constraints:sphnImagingMetric_Warning_DeprecatedCode a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Deprecated unversioned code reachable at path sphn:hasTypeCode" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            PREFIX sphn-loinc: <https://biomedit.ch/rdf/sphn-resource/loinc/>
            PREFIX sphn-hgnc: <https://biomedit.ch/rdf/sphn-resource/hgnc/>
            SELECT ?this (sphn:hasTypeCode as ?path) (?typeCode as ?value)
            WHERE {
            {
                ?this sphn:hasTypeCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-loinc:LOINC .
                ?typeCode rdfs:label ?label .
                FILTER(STRSTARTS(lcase(STR(?label)), "deprecated"))
            }
            UNION
            {
                ?this sphn:hasTypeCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                {
                    SELECT ?typeCode
                    WHERE {
                        ?typeCode rdf:type ?codeType .
                        FILTER(STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/GENO_") || STRSTARTS(STR(?typeCode), "http://purl.obolibrary.org/obo/SO_"))
                    }
                }
                ?typeCode owl:deprecated ?isDeprecated .
                FILTER(?isDeprecated)
            }
            UNION
            {
                ?this sphn:hasTypeCode ?oldCode .
                ?oldCode rdf:type ?typeCode .
                ?typeCode rdfs:subClassOf+ sphn-hgnc:HGNC .
                ?typeCode rdfs:comment ?comment .
                FILTER(lcase(STR(?comment))="entry withdrawn" || lcase(STR(?comment))="symbol withdrawn")
            }
            }""" ] ;
    sh:targetClass sphn:ImagingMetric .

constraints:sphnImagingMetric_Warning_MeaningChange a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The unversioned code reachable at path sphn:hasTypeCode has changed its meaning during the time. Please consider using a versioned code." ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                            SELECT ?this (rdf:type as ?path) (STR(?codeChange) as ?value)
                            WHERE {
                                ?this sphn:hasTypeCode/rdf:type ?type .
                                ?type sphn:hasMeaningChangeInHistorization ?codeChange .
                                }""" ] ;
    sh:targetClass sphn:ImagingMetric .

constraints:sphnImagingMetric_Warning_NamingConvention a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Instantiated unique resource not matching naming convention '^https://biomedit.ch/rdf/sphn-resource/.*-ImagingMetric-.*$'" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                         PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                         PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                         SELECT ?this (?class as ?path) (?this as ?value)
                         WHERE {
                             ?this rdf:type ?class .
                             FILTER(!REGEX(STR(?this), "^https://biomedit.ch/rdf/sphn-resource/.*-ImagingMetric-.*$"))
                             }""" ] ;
    sh:targetClass sphn:ImagingMetric .

constraints:sphnImagingProcedure a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:minCount 0 ;
            sh:or ( [ sh:class sphn:XRayImagingSeries ] [ sh:class sphn:ImagingSeries ] [ sh:class sphn:ComputedTomographyImagingSeries ] [ sh:class sphn:PositronEmissionTomographyImagingSeries ] [ sh:class sphn:MagneticResonanceImagingSeries ] ) ;
            sh:path sphn:hasImagingSeries ],
        [ sh:class sphn:BodyWeight ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasSubjectBodyWeight ],
        [ sh:class sphn:Intent ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasIntent ],
        [ sh:class sphn:AdministrativeCase ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasAdministrativeCase ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class snomed:77386006 ] [ sh:class snomed:60001007 ] ) ;
            sh:path sphn:hasSubjectPregnancyStatusCode ],
        [ sh:class sphn:SourceSystem ;
            sh:minCount 1 ;
            sh:path sphn:hasSourceSystem ],
        [ sh:class sphn:BodyHeight ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasSubjectBodyHeight ],
        [ sh:class sphn:BodyMassIndex ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasSubjectBodyMassIndex ],
        [ sh:class sphn:Age ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasSubjectAge ],
        [ sh:class sphn:AdministrativeSex ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasSubjectAdministrativeSex ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasEndDateTime ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasDescription ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sphn:hasStartDateTime ],
        [ sh:class snomed:363679005 ;
            sh:minCount 1 ;
            sh:path sphn:hasCode ],
        [ sh:class sphn:BodySite ;
            sh:minCount 0 ;
            sh:path sphn:hasBodySite ],
        [ sh:class sphn:SubjectPseudoIdentifier ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sphn:hasSubjectPseudoIdentifier ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "No descendents (all subclasses) of the specified codes are allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                                                PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                                                SELECT ?this (sphn:hasSubjectPregnancyStatusCode as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasSubjectPregnancyStatusCode/rdf:type ?class .
                                                    FILTER( ?values IN ( <http://snomed.info/id/77386006>, <http://snomed.info/id/60001007> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "Invalid time frame between sphn:hasStartDateTime and sphn:hasEndDateTime" ;
            sh:select """SELECT ?this (<https://biomedit.ch/rdf/sphn-schema/sphn#hasStartDateTime> as ?path) (?hasStartDateTime as ?value)
                    WHERE {
                        ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasStartDateTime> ?hasStartDateTime .
                        ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasEndDateTime> ?hasEndDateTime .
                        FILTER (?hasStartDateTime > ?hasEndDateTime)
                    }""" ] ;
    sh:targetClass sphn:ImagingProcedure .

constraints:sphnImagingProcedure_Warning_NamingConvention a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Instantiated shared resource not matching naming convention '^https://biomedit.ch/rdf/sphn-resource/.*-Code-.*$'" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                    PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                    SELECT ?this (sphn:hasCode as ?path) (?code as ?value)
                    WHERE {
                        ?this sphn:hasCode ?code .
                        FILTER(!REGEX(STR(?code), "^https://biomedit.ch/rdf/sphn-resource/.*-Code-.*$"))
                        }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "Instantiated shared resource not matching naming convention '^https://biomedit.ch/rdf/sphn-resource/.*-Code-.*$'" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                    PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                    SELECT ?this (sphn:hasSubjectPregnancyStatusCode as ?path) (?code as ?value)
                    WHERE {
                        ?this sphn:hasSubjectPregnancyStatusCode ?code .
                        FILTER(!REGEX(STR(?code), "^https://biomedit.ch/rdf/sphn-resource/.*-Code-.*$"))
                        }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "Instantiated unique resource not matching naming convention '^https://biomedit.ch/rdf/sphn-resource/.*-ImagingProcedure-.*$'" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                         PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                         PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                         SELECT ?this (?class as ?path) (?this as ?value)
                         WHERE {
                             ?this rdf:type ?class .
                             FILTER(!REGEX(STR(?this), "^https://biomedit.ch/rdf/sphn-resource/.*-ImagingProcedure-.*$"))
                             }""" ] ;
    sh:targetClass sphn:ImagingProcedure .

constraints:sphnImagingSeries a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( sphn:hasNumberOfFrames rdf:type ) ;
    sh:property [ sh:class sphn:SubjectPseudoIdentifier ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sphn:hasSubjectPseudoIdentifier ],
        [ sh:minCount 0 ;
            sh:or ( [ sh:class sphn:TimeSeriesDataFile ] [ sh:class sphn:DataFile ] ) ;
            sh:path sphn:hasDataFile ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasStartDateTime ],
        [ sh:class sphn:ImagingDevice ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasMedicalDevice ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasDescription ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasEndDateTime ],
        [ sh:class sphn:AdministrativeCase ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasAdministrativeCase ],
        [ sh:class sphn:ImagingFrame ;
            sh:minCount 0 ;
            sh:path sphn:hasImagingFrame ],
        [ sh:class sphn:SourceSystem ;
            sh:minCount 1 ;
            sh:path sphn:hasSourceSystem ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class dcm:PX ] [ sh:class dcm:RTIMAGE ] [ sh:class dcm:ECG ] [ sh:class dcm:OSS ] [ sh:class dcm:BDUS ] [ sh:class dcm:KER ] [ sh:class dcm:CT ] [ sh:class dcm:OPTBSV ] [ sh:class dcm:RF ] [ sh:class dcm:XA ] [ sh:class dcm:SRF ] [ sh:class dcm:RG ] [ sh:class dcm:GM ] [ sh:class dcm:DG ] [ sh:class dcm:DMS ] [ sh:class sphn:Code ] [ sh:class dcm:PA ] [ sh:class dcm:US ] [ sh:class dcm:OP ] [ sh:class dcm:TG ] [ sh:class dcm:DX ] [ sh:class dcm:LS ] [ sh:class dcm:OAM ] [ sh:class dcm:LEN ] [ sh:class dcm:IVOCT ] [ sh:class sphn:Terminology ] [ sh:class dcm:MG ] [ sh:class dcm:EEG ] [ sh:class dcm:IVUS ] [ sh:class dcm:OPT ] [ sh:class dcm:OPTENF ] [ sh:class dcm:EMG ] [ sh:class dcm:BMD ] [ sh:class dcm:OPM ] [ sh:class dcm:OPV ] [ sh:class dcm:CR ] [ sh:class dcm:HD ] [ sh:class dcm:RESP ] [ sh:class dcm:XC ] [ sh:class dcm:PT ] [ sh:class dcm:EOG ] [ sh:class dcm:CFM ] [ sh:class dcm:NM ] [ sh:class dcm:MR ] [ sh:class dcm:OCT ] [ sh:class dcm:ES ] [ sh:class dcm:BI ] [ sh:class dcm:SM ] [ sh:class snomed:360037004 ] [ sh:class dcm:AR ] [ sh:class dcm:VA ] [ sh:class dcm:IO ] [ sh:class dcm:POS ] [ sh:class dcm:EPS ] ) ;
            sh:path sphn:hasImagingModalityCode ],
        [ sh:class ucum:cblnbcbr ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path ( sphn:hasNumberOfFrames sphn:hasUnit sphn:hasCode ) ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasProtocolName ],
        [ sh:class sphn:Quantity ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasNumberOfFrames ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "For sphn:hasImagingFrame, instances of sphn:ComputedTomographyImagingFrame, sphn:MagneticResonanceImagingFrame, sphn:PositronEmissionTomographyImagingFrame, sphn:XRayImagingFrame are not allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                         SELECT ?this (<https://biomedit.ch/rdf/sphn-schema/sphn#hasImagingFrame> as ?path) (?class as ?value)
                         WHERE {
                             ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasImagingFrame>/rdf:type ?class.
                             FILTER(?class IN (<https://biomedit.ch/rdf/sphn-schema/sphn#ComputedTomographyImagingFrame>, <https://biomedit.ch/rdf/sphn-schema/sphn#MagneticResonanceImagingFrame>, <https://biomedit.ch/rdf/sphn-schema/sphn#PositronEmissionTomographyImagingFrame>, <https://biomedit.ch/rdf/sphn-schema/sphn#XRayImagingFrame>))
                         }""" ],
