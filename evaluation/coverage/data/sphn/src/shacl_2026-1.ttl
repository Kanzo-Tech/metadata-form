            sh:path ( sphn:hasEnergyQuantity sphn:hasUnit sphn:hasCode ) ],
        [ sh:class sphn:Quantity ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasQuantity ],
        [ sh:class sphn:Substance ;
            sh:minCount 0 ;
            sh:path sphn:hasSubstance ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "For sphn:hasSubstance, instances of sphn:ContrastAgentActiveIngredient, sphn:Radionuclide are not allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                         SELECT ?this (<https://biomedit.ch/rdf/sphn-schema/sphn#hasSubstance> as ?path) (?class as ?value)
                         WHERE {
                             ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasSubstance>/rdf:type ?class.
                             FILTER(?class IN (<https://biomedit.ch/rdf/sphn-schema/sphn#ContrastAgentActiveIngredient>, <https://biomedit.ch/rdf/sphn-schema/sphn#Radionuclide>))
                         }""" ] ;
