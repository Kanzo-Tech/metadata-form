                                                    FILTER( ?values IN ( <http://snomed.info/id/229027002>, <http://snomed.info/id/255235001>, <http://snomed.info/id/788800008>, <http://snomed.info/id/409051000>, <http://snomed.info/id/255566006>, <http://snomed.info/id/88694003> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
