                        FILTER(!REGEX(STR(?code), "^https://biomedit.ch/rdf/sphn-resource/.*-Code-.*$"))
                        }""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            SELECT ?this
                WHERE {
                ?this rdf:type sphn:Sample .
                MINUS {
                    ?this rdf:type sphn:Sample .
                    ?this rdf:type ?other_type .
                    FILTER (?other_type != sphn:Sample )
                    ?this rdfs:subClassOf+  sphn:Sample .
                    }
                }""" ] .

