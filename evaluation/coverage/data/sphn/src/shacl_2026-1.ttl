constraints:sphnTimePattern a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( sphn:hasFrequency sphn:hasOffset rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class ucum:wk ] [ sh:class ucum:a ] [ sh:class ucum:min ] [ sh:class ucum:ms ] [ sh:class ucum:h ] [ sh:class ucum:s ] [ sh:class ucum:mo ] [ sh:class ucum:d ] ) ;
            sh:path ( sphn:hasOffset sphn:hasUnit sphn:hasCode ) ],
        [ sh:class sphn:Quantity ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasFrequency ],
        [ sh:class snomed:272106006 ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasTimeOfDayCode ],
        [ sh:class sphn:Quantity ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasOffset ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class ucum:cblnbcbrpermsec ] [ sh:class ucum:cblnbcbrperwk ] [ sh:class ucum:cblnbcbrpera ] [ sh:class ucum:cblnbcbrperh ] [ sh:class ucum:cblnbcbrpermo ] [ sh:class ucum:cblnbcbrpermin ] [ sh:class ucum:cblnbcbrpersec ] [ sh:class ucum:cblnbcbrperd ] ) ;
            sh:path ( sphn:hasFrequency sphn:hasUnit sphn:hasCode ) ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class snomed:255238004 ] [ sh:class snomed:7087005 ] [ sh:class snomed:225761000 ] ) ;
            sh:path sphn:hasTypeCode ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "No descendents (all subclasses) of the specified codes are allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                                                PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                                                SELECT ?this (sphn:hasTypeCode as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasTypeCode/rdf:type ?class .
                                                    FILTER( ?values IN ( <http://snomed.info/id/255238004>, <http://snomed.info/id/7087005>, <http://snomed.info/id/225761000> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ] ;
    sh:targetClass sphn:TimePattern .

