                             FILTER(?class IN (<https://biomedit.ch/rdf/sphn-schema/sphn#TumorGradeAssessmentResult>, <https://biomedit.ch/rdf/sphn-schema/sphn#TumorStageAssessmentResult>, <https://biomedit.ch/rdf/sphn-schema/sphn#VitalStatus>))
                         }""" ] ;
