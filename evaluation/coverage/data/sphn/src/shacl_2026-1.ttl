constraints:sphnDrug a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sphn:Substance ;
            sh:minCount 0 ;
            sh:path sphn:hasActiveIngredient ],
        [ sh:class sphn:Quantity ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasQuantity ],
        [ sh:class sphn:SourceSystem ;
            sh:minCount 1 ;
            sh:path sphn:hasSourceSystem ],
        [ sh:class sphn:Substance ;
            sh:minCount 0 ;
            sh:path sphn:hasInactiveIngredient ],
        [ sh:class sphn:DrugArticle ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasArticle ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "For sphn:hasActiveIngredient, instances of sphn:ContrastAgentActiveIngredient, sphn:Radionuclide are not allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                         SELECT ?this (<https://biomedit.ch/rdf/sphn-schema/sphn#hasActiveIngredient> as ?path) (?class as ?value)
                         WHERE {
                             ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasActiveIngredient>/rdf:type ?class.
                             FILTER(?class IN (<https://biomedit.ch/rdf/sphn-schema/sphn#ContrastAgentActiveIngredient>, <https://biomedit.ch/rdf/sphn-schema/sphn#Radionuclide>))
                         }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "For sphn:hasInactiveIngredient, instances of sphn:ContrastAgentActiveIngredient, sphn:Radionuclide are not allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                         SELECT ?this (<https://biomedit.ch/rdf/sphn-schema/sphn#hasInactiveIngredient> as ?path) (?class as ?value)
                         WHERE {
                             ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasInactiveIngredient>/rdf:type ?class.
                             FILTER(?class IN (<https://biomedit.ch/rdf/sphn-schema/sphn#ContrastAgentActiveIngredient>, <https://biomedit.ch/rdf/sphn-schema/sphn#Radionuclide>))
                         }""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            SELECT ?this
                WHERE {
                ?this rdf:type sphn:Drug .
                MINUS {
                    ?this rdf:type sphn:Drug .
                    ?this rdf:type ?other_type .
                    FILTER (?other_type != sphn:Drug )
                    ?this rdfs:subClassOf+  sphn:Drug .
                    }
                }""" ] .

constraints:sphnDrugAdministrationEvent a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( sphn:hasTimePattern rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasEndDateTime ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sphn:hasStartDateTime ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class snomed:255238004 ] [ sh:class snomed:7087005 ] ) ;
            sh:path ( sphn:hasTimePattern sphn:hasTypeCode ) ],
        [ sh:class snomed:284009009 ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasAdministrationRouteCode ],
        [ sh:class sphn:AdministrativeCase ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasAdministrativeCase ],
        [ sh:class sphn:Drug ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sphn:hasDrug ],
        [ sh:class sphn:Quantity ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasDuration ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class snomed:419620001 ] [ sh:class snomed:74964007 ] [ sh:class snomed:182844005 ] [ sh:class snomed:441308009 ] [ sh:class snomed:395007004 ] [ sh:class snomed:395009001 ] [ sh:class snomed:31438003 ] [ sh:class snomed:399307001 ] [ sh:class snomed:182846007 ] [ sh:class snomed:182845006 ] [ sh:class snomed:182872003 ] ) ;
            sh:path sphn:hasReasonToStopCode ],
        [ sh:class sphn:SubjectPseudoIdentifier ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sphn:hasSubjectPseudoIdentifier ],
        [ sh:class sphn:SourceSystem ;
            sh:minCount 1 ;
            sh:path sphn:hasSourceSystem ],
        [ sh:class sphn:TimePattern ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasTimePattern ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "No descendents (all subclasses) of the specified codes are allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                                                PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                                                SELECT ?this (sphn:hasReasonToStopCode as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasReasonToStopCode/rdf:type ?class .
                                                    FILTER( ?values IN ( <http://snomed.info/id/419620001>, <http://snomed.info/id/74964007>, <http://snomed.info/id/182844005>, <http://snomed.info/id/441308009>, <http://snomed.info/id/395007004>, <http://snomed.info/id/395009001>, <http://snomed.info/id/31438003>, <http://snomed.info/id/399307001>, <http://snomed.info/id/182846007>, <http://snomed.info/id/182845006>, <http://snomed.info/id/182872003> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "No descendents (all subclasses) of the specified codes are allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                                                PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                                                SELECT ?this ("sphn:hasTimePattern/sphn:hasTypeCode" as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasTimePattern/sphn:hasTypeCode/rdf:type ?class .
                                                    FILTER( ?values IN ( <http://snomed.info/id/255238004>, <http://snomed.info/id/7087005> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "Invalid time frame between sphn:hasStartDateTime and sphn:hasEndDateTime" ;
            sh:select """SELECT ?this (<https://biomedit.ch/rdf/sphn-schema/sphn#hasStartDateTime> as ?path) (?hasStartDateTime as ?value)
                    WHERE {
                        ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasStartDateTime> ?hasStartDateTime .
                        ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasEndDateTime> ?hasEndDateTime .
                        FILTER (?hasStartDateTime > ?hasEndDateTime)
                    }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "For sphn:hasDrug, instances of sphn:ContrastAgent, sphn:Radiopharmaceutical are not allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                         SELECT ?this (<https://biomedit.ch/rdf/sphn-schema/sphn#hasDrug> as ?path) (?class as ?value)
                         WHERE {
                             ?this <https://biomedit.ch/rdf/sphn-schema/sphn#hasDrug>/rdf:type ?class.
                             FILTER(?class IN (<https://biomedit.ch/rdf/sphn-schema/sphn#ContrastAgent>, <https://biomedit.ch/rdf/sphn-schema/sphn#Radiopharmaceutical>))
                         }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "No descendents (all subclasses) of the specified codes are allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                                                PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                                                SELECT ?this (sphn:hasTimePattern as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasTimePattern/rdf:type ?class .
                                                    FILTER( ?values IN ( <https://biomedit.ch/rdf/sphn-schema/sphn#TimePattern> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            SELECT ?this
                WHERE {
                ?this rdf:type sphn:DrugAdministrationEvent .
                MINUS {
                    ?this rdf:type sphn:DrugAdministrationEvent .
                    ?this rdf:type ?other_type .
                    FILTER (?other_type != sphn:DrugAdministrationEvent )
                    ?this rdfs:subClassOf+  sphn:DrugAdministrationEvent .
                    }
                }""" ] .

constraints:sphnDrugAdministrationEvent_Warning_NamingConvention a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
