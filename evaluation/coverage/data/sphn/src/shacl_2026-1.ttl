                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                                                PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                                                SELECT ?this ("sphn:hasDataDetermination/sphn:hasMethodCode" as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasDataDetermination/sphn:hasMethodCode/rdf:type ?class .
                                                    FILTER( ?values IN ( <http://snomed.info/id/258104002>, <http://snomed.info/id/263760002>, <http://snomed.info/id/87982008>, <http://snomed.info/id/258090004> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ],
        [ a sh:SPARQLConstraint ;
