                                                SELECT ?this (sphn:hasCode as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasCode/rdf:type ?class .
                                                    FILTER( ?values IN ( <http://snomed.info/id/281036007>, <http://snomed.info/id/386473003> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ] ;
    sh:targetClass sphn:FollowUp .

