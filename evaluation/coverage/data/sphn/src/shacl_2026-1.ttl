            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                                                PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                                                SELECT ?this (sphn:hasQuantityEstimateCode as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasQuantityEstimateCode/rdf:type ?class .
                                                    FILTER( ?values IN ( <http://snomed.info/id/260413007>, <http://snomed.info/id/260396001>, <http://snomed.info/id/57176003>, <http://snomed.info/id/46998006>, <http://snomed.info/id/1255665007> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ] ;
    sh:targetClass sphn:MicroorganismIdentificationResult .

