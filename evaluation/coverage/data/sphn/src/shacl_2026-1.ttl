    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class so:0005836 ;
            sh:minCount 0 ;
            sh:path sphn:hasRegulatoryFeatureCode ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class sphn:ChromosomalLocation ] [ sh:class sphn:GenomicPosition ] ) ;
            sh:path sphn:hasFeatureLocation ],
