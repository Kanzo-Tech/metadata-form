            sh:path sphn:hasSourceSystem ],
        [ sh:class sphn:Age ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasSubjectAge ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class snomed:63161005 ] [ sh:class snomed:1354479004 ] [ sh:class snomed:2603003 ] ) ;
            sh:path sphn:hasRankCode ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasRecordDateTime ],
        [ sh:class icd-10-gm:ICD-10-GM ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sphn:hasCode ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "No descendents (all subclasses) of the specified codes are allowed" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                                                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                                                PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                                                SELECT ?this (sphn:hasRankCode as ?path) (?class as ?value)
                                                WHERE {
                                                    ?this sphn:hasRankCode/rdf:type ?class .
                                                    FILTER( ?values IN ( <http://snomed.info/id/63161005>, <http://snomed.info/id/1354479004>, <http://snomed.info/id/2603003> )) .
                                                    FILTER (?class NOT IN ( ?values ) ) .
                                                    FILTER NOT EXISTS { ?values rdfs:subClassOf+ ?class .}
                                                }""" ] ;
    sh:targetClass sphn:BilledDiagnosis .

constraints:sphnBilledDiagnosis_Info_NotValid a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The versioned code reachable by path sphn:hasCode/rdf:type is not valid anymore due to code meaning change" ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                     PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
                     SELECT ?this (rdf:type as ?path) (?type as ?value)
                     WHERE {
                         ?this sphn:hasCode/rdf:type ?type .
