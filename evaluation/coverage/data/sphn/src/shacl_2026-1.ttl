constraints:sphnPixelDimensions a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( sphn:hasColumnSpacing sphn:hasRowSpacing rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class ucum:um ] [ sh:class ucum:pm ] [ sh:class ucum:mm ] [ sh:class ucum:fm ] [ sh:class ucum:nm ] ) ;
            sh:path ( sphn:hasRowSpacing sphn:hasUnit sphn:hasCode ) ],
        [ sh:class sphn:Quantity ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasColumnSpacing ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:class ucum:um ] [ sh:class ucum:pm ] [ sh:class ucum:mm ] [ sh:class ucum:fm ] [ sh:class ucum:nm ] ) ;
            sh:path ( sphn:hasColumnSpacing sphn:hasUnit sphn:hasCode ) ],
        [ sh:class sphn:Quantity ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasRowSpacing ] ;
    sh:targetClass sphn:PixelDimensions .

