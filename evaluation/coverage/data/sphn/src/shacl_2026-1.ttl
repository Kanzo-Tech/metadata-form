                         SELECT ?this (?class as ?path) (?this as ?value)
                         WHERE {
                             ?this rdf:type ?class .
                             FILTER(!REGEX(STR(?this), "^https://biomedit.ch/rdf/sphn-resource/.*-NucleotideSequence-.*$"))
                             }""" ] ;
    sh:targetClass sphn:NucleotideSequence .

