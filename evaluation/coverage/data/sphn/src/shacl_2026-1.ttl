            PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
            SELECT ?this
                WHERE {
                ?this rdf:type sphn:Algorithm .
                MINUS {
                    ?this rdf:type sphn:Algorithm .
                    ?this rdf:type ?other_type .
                    FILTER (?other_type != sphn:Algorithm )
