constraints:sphnRadiopharmaceuticalAdministrationEvent a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( sphn:hasTimePattern rdf:type ) ;
    sh:property [ sh:class sphn:Radiopharmaceutical ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sphn:hasDrug ],
        [ sh:class sphn:AdministrativeCase ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path sphn:hasAdministrativeCase ],
