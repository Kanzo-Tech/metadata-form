@prefix adms:         <http://www.w3.org/ns/adms#> .
@prefix csvw:         <http://www.w3.org/ns/csvw#> .
@prefix dcat:         <http://www.w3.org/ns/dcat#> .
@prefix dcatap:       <http://data.europa.eu/r5r/> .
@prefix dct:          <http://purl.org/dc/terms/> .
@prefix evds:         <https://dataspace.evidenze.example/ns#> .
@prefix evds-voc:     <https://dataspace.evidenze.example/voc#> .
@prefix foaf:         <http://xmlns.com/foaf/0.1/> .
@prefix healthdcatap: <http://healthdataportal.eu/ns/health#> .
@prefix prov:         <http://www.w3.org/ns/prov#> .
@prefix res:          <https://data.evidenze.ai/resource/msk-demo/> .
@prefix vcard:        <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd:          <http://www.w3.org/2001/XMLSchema#> .

# AIFOS · MSK Cancer Therapy — HealthDCAT-AP R7 (trimmed demo: 8 of 54 variables).

res:dataset
    a dcat:Dataset ;
    dct:title "Terapias oncológicas MSK — cohorte de impacto clínico"@es ;
    dct:description "Conjunto de datos observacionales sobre terapias oncológicas y hematopoyesis clonal derivado del panel MSK-IMPACT."@es ;
    dct:identifier "did:web:data.evidenze.ai:datasets:msk-demo"^^xsd:string ;
    dcat:landingPage <https://data.evidenze.ai/datasets/msk-demo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dcat:keyword "MSK-IMPACT"@es , "oncología"@es , "genómica"@es , "hematopoyesis clonal"@es ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dct:publisher res:publisher ;
    dcat:contactPoint res:contact ;
    dcat:distribution res:distribution ;
    evds:participantDID "did:web:aifos.digital"^^xsd:string ;
    evds:dataspaceRole evds-voc:provider ;
    evds:organisationalUnit "AIFOS DIGITAL"^^xsd:string ;
    evds:environmentZone evds-voc:production ;
    healthdcatap:healthCategory <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/PGEH> ;
    healthdcatap:healthTheme <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme/CANCER_DISEASE> ;
    healthdcatap:hdab res:hdab ;
    prov:wasGeneratedBy <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-activity/OBSERVATIONAL_DATA> ;
    healthdcatap:hasStructuredData true ;
    healthdcatap:hasVariables res:variables .

res:publisher
    a foaf:Agent ;
    foaf:name "AIFOS DIGITAL, S.L.U."^^xsd:string ;
    dct:type <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/publisher-type/private-company> ;
    foaf:homepage <https://aifos.digital> .

res:contact
    a vcard:Kind ;
    vcard:fn "Contacto de datos AIFOS"^^xsd:string ;
    vcard:hasEmail <mailto:data@aifos.digital> .

res:hdab
    a foaf:Agent ;
    foaf:name "Health Data Access Body de referencia para Evidenze Data Space"^^xsd:string ;
    dcatap:contactPoint res:hdab-contact .

res:hdab-contact
    a vcard:Kind ;
    vcard:fn "Contacto HDAB Evidenze"^^xsd:string ;
    vcard:hasEmail <mailto:hdab@evidenze.example> .

res:distribution
    a dcat:Distribution ;
    dcat:accessURL <https://data.evidenze.ai/datasets/msk-demo> ;
    dcat:downloadURL <https://data.evidenze.ai/datasets/msk-demo/download.xlsx> ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/XLSX> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_SA> ;
    dcatap:availability <http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE> ;
    adms:status <http://publications.europa.eu/resource/authority/distribution-status/COMPLETED> .

res:variables
    a csvw:TableGroup ;
    csvw:table res:main-table .

res:main-table
    a csvw:Table ;
    dct:title "Tabla principal de variables clínicas y genómicas"@es ;
    csvw:url <https://data.evidenze.ai/datasets/msk-demo/main.csv> ;
    csvw:column
        res:col-age,
        res:col-sex,
        res:col-cancer-type,
        res:col-cancer-type-detailed,
        res:col-sample-type,
        res:col-mutation-count,
        res:col-tumor-purity,
        res:col-vital-status .

res:col-age
    a csvw:Column ;
    csvw:name "Age"^^xsd:string ;
    csvw:title "Edad"@es ;
    dct:description "Edad del paciente en el momento de la muestra (codificada)."@es ;
    csvw:datatype "decimal" .

res:col-sex
    a csvw:Column ;
    csvw:name "Sex"^^xsd:string ;
    csvw:title "Sexo"@es ;
    dct:description "Sexo biológico del paciente."@es ;
    csvw:datatype "string" .

res:col-cancer-type
    a csvw:Column ;
    csvw:name "Cancer_Type"^^xsd:string ;
    csvw:title "Tipo de cáncer"@es ;
    dct:description "Tipo de cáncer principal según la clasificación del panel."@es ;
    csvw:datatype "string" .

res:col-cancer-type-detailed
    a csvw:Column ;
    csvw:name "Cancer_Type_Detailed"^^xsd:string ;
    csvw:title "Tipo de cáncer (detallado)"@es ;
    dct:description "Subtipo detallado del cáncer."@es ;
    csvw:datatype "string" .

res:col-sample-type
    a csvw:Column ;
    csvw:name "Sample_Type"^^xsd:string ;
    csvw:title "Tipo de muestra"@es ;
    dct:description "Origen de la muestra analizada (primaria o metastásica)."@es ;
    csvw:datatype "string" .

res:col-mutation-count
    a csvw:Column ;
    csvw:name "Mutation_Count"^^xsd:string ;
    csvw:title "Recuento de mutaciones"@es ;
    dct:description "Número de mutaciones somáticas detectadas."@es ;
    csvw:datatype "decimal" .

res:col-tumor-purity
    a csvw:Column ;
    csvw:name "Tumor_Purity"^^xsd:string ;
    csvw:title "Pureza tumoral"@es ;
    dct:description "Porcentaje estimado de células tumorales en la muestra."@es ;
    csvw:datatype "decimal" .

res:col-vital-status
    a csvw:Column ;
    csvw:name "Vital_Status"^^xsd:string ;
    csvw:title "Estado vital"@es ;
    dct:description "Estado vital del paciente en el último seguimiento."@es ;
    csvw:datatype "string" .
