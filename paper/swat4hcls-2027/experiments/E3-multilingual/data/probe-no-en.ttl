@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .
ex:DatasetShape a sh:NodeShape ; sh:targetClass ex:Dataset ;
  sh:property [ sh:path ex:identifier ; sh:minCount 1 ;
    sh:message "CA-message"@ca ;
    sh:message "ES-message"@es ;
    sh:message "DE-message"@de ; ] .
