@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode ex:d1 ;
            sh:resultMessage "Un conjunt de dades ha de tenir un identificador."@ca,
                "A dataset must have an identifier."@en,
                "Un conjunto de datos debe tener un identificador."@es ;
            sh:resultPath ex:identifier ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Un conjunt de dades ha de tenir un identificador."@ca,
                        "A dataset must have an identifier."@en,
                        "Un conjunto de datos debe tener un identificador."@es ;
                    sh:minCount 1 ;
                    sh:path ex:identifier ] ],
        [ a sh:ValidationResult ;
            sh:focusNode ex:d1 ;
            sh:resultMessage "Issue date must be an xsd:date." ;
            sh:resultPath ex:issued ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:message "Issue date must be an xsd:date." ;
                    sh:path ex:issued ] ;
            sh:value "March 2026" ] .

