@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix dpv:  <https://w3id.org/dpv#> .
@prefix dpv-pd: <https://w3id.org/dpv/dpv-pd#> .
@prefix eu:   <http://publications.europa.eu/resource/authority/access-right/> .
@prefix ex:   <http://example.org/e2/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:dataset a dcat:Dataset ;
    dct:title "Example health dataset"@en ;
    dct:description "A record used only to exercise the conditional."@en ;
    dct:identifier "e2-dataset-1" ;
    dcat:keyword "health"@en ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dct:accessRights eu:RESTRICTED ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dct:creator ex:agent ;
    dct:publisher ex:agent ;
    dcat:contactPoint ex:contact ;
    dpv:hasPersonalData dpv-pd:Gender ;
    dpv:hasLegalBasis <https://w3id.org/dpv#Consent> .

ex:agent a foaf:Agent ;
    foaf:name "Example Data Holder" ;
    dct:identifier "e2-agent-1" ;
    foaf:mbox <mailto:data@example.org> ;
    foaf:homepage <http://example.org/> .

ex:contact a vcard:Kind ;
    vcard:fn "Example Contact" ;
    vcard:hasEmail <mailto:contact@example.org> .
