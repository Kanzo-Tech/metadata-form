@prefix dpv:  <https://w3id.org/dpv#> .
@prefix hri:  <http://data.health-ri.nl/core/p2/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# Overlay 03 — SHACL 1.0, material implication.
#
# The only way to keep the condition inside hri:DatasetShape's own target without
# SPARQL: write "C ⇒ T" as "¬C ∨ T". Correct, self-contained, and backwards —
# the reader meets the negation of the condition before the condition, and the
# branch that fires is the one that is NOT mentioned first. A form generator sees
# a disjunction of two anonymous shapes and cannot tell which arm is the guard.

hri:DatasetShape
  sh:or (
    [ sh:not [ sh:property [ sh:path dpv:hasPersonalData ; sh:minCount 1 ] ] ]
    [ sh:property [ sh:path dpv:hasLegalBasis ; sh:minCount 1 ] ;
      sh:property [ sh:path dpv:hasPurpose    ; sh:minCount 1 ] ]
  ) ;
  sh:message "A dataset that declares personal data must state its legal basis and purpose."@en .
