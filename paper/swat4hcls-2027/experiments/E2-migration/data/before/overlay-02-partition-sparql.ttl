@prefix dash: <http://datashapes.org/dash#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dpv:  <https://w3id.org/dpv#> .
@prefix hri:  <http://data.health-ri.nl/core/p2/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# Overlay 02 — SHACL 1.0 advanced, node-shape partition selected by SPARQL.
#
# Overlay 01 leaks: sh:targetSubjectsOf selects EVERY subject of
# dpv:hasPersonalData, not only the datasets. Closing the leak in SHACL 1.0 means
# putting the condition into a SPARQL string inside the shapes graph — the
# condition is now expressed in a second language, invisible to any tool that
# reads shapes structurally (form generators, documentation, diffing).

hri:PersonalDataDatasetShapeSparql
  a sh:NodeShape ;
  rdfs:label "Dataset carrying personal data"@en ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes hri:E2Prefixes ;
    sh:select """
      SELECT ?this
      WHERE {
        ?this a dcat:Dataset .
        ?this dpv:hasPersonalData ?pd .
      }
    """ ;
  ] ;
  sh:property hri:PersonalDataDatasetShapeSparql-stamp ,
              hri:PersonalDataDatasetShapeSparql-legal-basis ,
              hri:PersonalDataDatasetShapeSparql-purpose .

hri:PersonalDataDatasetShapeSparql-stamp
  sh:path dpv:hasPersonalData ;
  sh:minCount 1 ;
  dash:hidden true .

hri:PersonalDataDatasetShapeSparql-legal-basis
  sh:path dpv:hasLegalBasis ;
  sh:name "legal basis"@en ;
  sh:minCount 1 ;
  sh:nodeKind sh:IRI ;
  dash:viewer dash:URIViewer ;
  dash:editor dash:URIEditor .

hri:PersonalDataDatasetShapeSparql-purpose
  sh:path dpv:hasPurpose ;
  sh:name "purpose"@en ;
  sh:minCount 1 ;
  sh:nodeKind sh:IRI ;
  dash:viewer dash:LabelViewer ;
  dash:editor dash:URIEditor .

hri:E2Prefixes
  a <http://www.w3.org/2002/07/owl#Ontology> ;
  sh:declare [ sh:prefix "dcat" ; sh:namespace "http://www.w3.org/ns/dcat#"^^<http://www.w3.org/2001/XMLSchema#anyURI> ] ,
             [ sh:prefix "dpv"  ; sh:namespace "https://w3id.org/dpv#"^^<http://www.w3.org/2001/XMLSchema#anyURI> ] .
